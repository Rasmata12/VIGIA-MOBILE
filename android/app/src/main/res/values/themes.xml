<resources>
    <style name="Theme.Vigia" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#050A1E</item>
        <item name="android:navigationBarColor">#050A1E</item>
        <item name="android:windowBackground">#050A1E</item>
    </style>
    <style name="Theme.Vigia.Transparent" parent="android:Theme.Material.NoActionBar">
