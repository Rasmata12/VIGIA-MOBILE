# Copie ce fichier en .env et remplis tes propres valeurs.
# NE JAMAIS committer le fichier .env (il est exclu par .gitignore).

VIGIA_ENV=development

# Genere avec : python -c "import secrets;print(secrets.token_urlsafe(64))"
VIGIA_JWT_SECRET=dev-insecure-secret-change-me
VIGIA_JWT_ALGORITHM=HS256
VIGIA_ACCESS_TOKEN_MINUTES=30
VIGIA_REFRESH_TOKEN_DAYS=60

# SQLite en local. En production (Render), utiliser une URL Postgres :
# VIGIA_DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
VIGIA_DATABASE_URL=sqlite:///./vigia.db

# --- Reputation d'URL (optionnel, desactive si vide) ---
VIGIA_GOOGLE_SAFEBROWSING_KEY=
VIGIA_VIRUSTOTAL_KEY=

# --- Couche IA ---
# "ollama" (modele local gratuit), "openai_compatible" (Groq/OpenRouter...) ou "none".
VIGIA_AI_PROVIDER=ollama

VIGIA_OLLAMA_BASE_URL=http://localhost:11434
VIGIA_OLLAMA_MODEL=llama3.2

# Pour Groq : VIGIA_OC_BASE_URL=https://api.groq.com/openai/v1
VIGIA_OC_BASE_URL=
VIGIA_OC_API_KEY=
VIGIA_OC_MODEL=

# Hugging Face Inference Providers (optionnel : la clé peut aussi être fournie par l'app)
VIGIA_HF_TOKEN=
VIGIA_HF_MODEL=openai/gpt-oss-120b:fastest
VIGIA_HF_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VIGIA_HF_BASE_URL=https://router.huggingface.co/v1

VIGIA_AI_REQUEST_TIMEOUT=60.0

VIGIA_ALLOW_NETWORK_PROBES=true
VIGIA_RATE_LIMIT_ENABLED=true
VIGIA_HTTP_TIMEOUT=6.0
