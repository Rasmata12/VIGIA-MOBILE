<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET : communication avec le backend d'analyse. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ACCESS_NETWORK_STATE : detecter l'absence de reseau pour basculer en analyse locale. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- POST_NOTIFICATIONS : alerter l'utilisateur quand une analyse reelle detecte un danger. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- CAMERA : uniquement pour le scanner de QR code, demandee au moment du scan. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Aucune autre permission : pas de SMS, pas de contacts, pas de localisation. -->

    <application
        android:name=".VigiaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vigia">

        <!-- FileProvider : permet de partager/enregistrer le fichier JSON genere par
             GET /privacy/export sans exposer de chemin de fichier brut (RGPD, export souverain). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Vigia">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Partage : VIGIA apparait dans le menu "Partager" de WhatsApp, SMS, Gmail...
             et dans le menu de selection de texte (PROCESS_TEXT). -->
        <activity
            android:name=".ShareAnalyzeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Vigia.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vigia" android:host="verify" />
            </intent-filter>
        </activity>

        <!-- Deep links : vigia://analysis/{id}, vigia://alert/{id}, vigia://history,
             vigia://moment, vigia://settings/permissions -->
        <activity-alias
            android:name=".DeepLinkActivity"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vigia" android:host="analysis" />
                <data android:scheme="vigia" android:host="alert" />
                <data android:scheme="vigia" android:host="history" />
                <data android:scheme="vigia" android:host="moment" />
                <data android:scheme="vigia" android:host="settings" />
            </intent-filter>
        </activity-alias>

        <!-- VIGIA GUARD : service officiel Android. Sans activation manuelle par
             l'utilisateur dans les reglages, il ne recoit rien. -->
        <service
            android:name=".guard.VigiaNotificationListener"
            android:exported="false"
            android:label="VIGIA Guard"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!-- Android 12+ : limiter l'écoute par défaut aux notifications utiles à la protection. -->
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting" />
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="ongoing|silent" />
        </service>
    </application>
</manifest>
